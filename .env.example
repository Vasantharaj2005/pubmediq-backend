# ============================================================
# PubMedIQ Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ----------------------------
# Application
# ----------------------------
APP_NAME=PubMedIQ
APP_VERSION=0.1.0
APP_ENV=production            # development | staging | production
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# ----------------------------
# Server
# ----------------------------
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=1
RELOAD=false

# ----------------------------
# CORS
# ----------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
CORS_ALLOW_CREDENTIALS=true

# ----------------------------
# PostgreSQL
# ----------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pubmediq
POSTGRES_USER=pubmediq
POSTGRES_PASSWORD=your-postgres-password
# Required by docker-compose.yml for the Postgres container and app connection.
DB_PASSWORD=your-postgres-password
DATABASE_URL=postgresql+asyncpg://pubmediq:your-postgres-password@postgres:5432/pubmediq

# ----------------------------
# Redis
# ----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Cache TTL (seconds)
CACHE_TTL_SEARCH=3600         # 1 hour for search results
CACHE_TTL_ARTICLE=86400       # 24 hours for article metadata
CACHE_TTL_SESSION=1800        # 30 min for chat sessions

# ----------------------------
# JWT Authentication
# ----------------------------
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------
# LLM Providers
# ----------------------------
# Default model provider: gemini | openai | groq | auto
DEFAULT_LLM_PROVIDER=groq

# Google Gemini (free tier: gemini-1.5-flash)
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro

# OpenAI (gpt-4o-mini affordable)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq (free tier: llama3, mixtral, gemma)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FAST_MODEL=gemma2-9b-it

# ----------------------------
# Embeddings (Local HuggingFace)
# ----------------------------
# Biomedical-specific embedding model (free, open-source)
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
EMBEDDING_DEVICE=cpu           # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=768

# ----------------------------
# Reranker (Local Cross-Encoder)
# ----------------------------
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu            # cpu | cuda | mps
RERANKER_TOP_K=10              # number of results to rerank

# ----------------------------
# Pinecone Vector Database
# ----------------------------
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=pubmediq-articles
PINECONE_NAMESPACE=pubmed

# ----------------------------
# NCBI PubMed API
# ----------------------------
NCBI_API_KEY=your-ncbi-api-key   # get free at: https://www.ncbi.nlm.nih.gov/account/
NCBI_EMAIL=your-email@example.com
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_RATE_LIMIT=10             # requests/sec (3 without key, 10 with key)

# ----------------------------
# LangSmith Observability
# ----------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=pubmediq-hackathon
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ----------------------------
# Search Configuration
# ----------------------------
MAX_REFINEMENTS=2
QUALITY_THRESHOLD=0.65
DEFAULT_TOP_K=20
MAX_TOP_K=100
PUBMED_MAX_RESULTS=100

# ----------------------------
# Rate Limiting
# ----------------------------
RATE_LIMIT_REQUESTS=100          # per minute per IP
RATE_LIMIT_SEARCH=20             # search requests per minute per user
